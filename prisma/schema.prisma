// use prisma-next

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  username  String?
  bio      String?
  imageUrl  String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

